# ============================================================
# 家庭药箱 · 环境变量模板
# 复制为 .env.local 后填入真实值；.env.local 已被 git 忽略。
# ============================================================
#
# 规则（硬约束）：
# 1. 只允许 EXPO_PUBLIC_* —— 这些值会被打进 App bundle，必须是可以公开的值。
# 2. 绝对不要在这里放 Supabase service role key。
# 3. 绝对不要在这里放任何 AI 供应商密钥（DeepSeek / 智谱 / 通义 等）。
#    AI 密钥只存在于 Supabase Edge Function secrets：
#      supabase secrets set AI_API_KEY=... AI_PROVIDER=... AI_MODEL=...
# 4. 提交前跑 `npm run check:secrets`。

EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# anon key 可以公开（安全性由 RLS 保证），但仍需与 service role key 严格区分
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
